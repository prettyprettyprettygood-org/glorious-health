---
import { SITE } from '../../config/site';
---

<header class="site-header">
  <div class="site-header-inner container">
    <a href="/" class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand-kicker">{SITE.tagline}</span>
      <span class="brand-wordmark">
        <span class="brand-primary">Glorious</span>{' '}
        <span class="brand-secondary" aria-label="Health">
          <span aria-hidden="true">Heal<span class="brand-t">&#x271D;</span>h</span>
        </span>
      </span>
    </a>

    <nav aria-label="Primary" class="site-nav">
      <ul>
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
