---
import { SITE } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class={`brand ${className}`.trim()} aria-label={`${SITE.name} home`}>
  <span class="brand-kicker">{SITE.tagline}</span>
  <span class="brand-wordmark">
    <span class="brand-primary">Glorious</span>{' '}
    <span class="brand-secondary" aria-label="Health">
      <span aria-hidden="true">Heal<span class="brand-t">&#x271D;</span>h</span>
    </span>
  </span>
</a>
