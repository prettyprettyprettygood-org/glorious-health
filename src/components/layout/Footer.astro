---
import { ArrowUp } from '@lucide/astro';
import { SITE } from '../../config/site';
import Brand from './Brand.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner container">
    <div class="footer-brand">
      <Brand />
    </div>

    <div class="footer-center">
      <nav aria-label="Footer">
        <ul class="footer-links">
          {
            SITE.footerLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer-text">
        <p class="footer-copy">© {year} {SITE.name}. All rights reserved.</p>
        <p class="footer-credit">
          Built by{' '}
          <a
            href="https://www.prettyprettyprettygood.org/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pretty Pretty Pretty Good
          </a>
        </p>
      </div>
    </div>

    <div class="footer-top">
      <button type="button" class="footer-top-button" data-scroll-top aria-label="Back to top">
        <ArrowUp aria-hidden="true" />
      </button>
      <p class="footer-top-label" aria-hidden="true">Back to top</p>
    </div>
  </div>

  <script is:inline>
    (() => {
      const button = document.querySelector('[data-scroll-top]');
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      button.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    })();
  </script>
</footer>
