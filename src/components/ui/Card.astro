---
import { ExternalLink } from '@lucide/astro';

interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  external?: boolean;
  class?: string;
}

const { title, eyebrow, href, external = false, class: className = '' } = Astro.props;
---

<article class={`card ${href ? 'card-link' : ''} ${className}`.trim()}>
  {
    external && (
      <span class="card-external-badge" aria-hidden="true">
        <ExternalLink />
      </span>
    )
  }
  <slot name="icon" />
  {eyebrow && <p class="card-eyebrow">{eyebrow}</p>}
  <h3 class="card-title">
    {
      href ? (
        <a
          href={href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <div class="card-body">
    <slot />
  </div>
</article>
