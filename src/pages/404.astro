---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`Page Not Found — ${SITE.name}`}
  description="This page couldn't be found."
  robots="noindex, follow"
>
  <section class="section hero stack">
    <p class="not-found-code" aria-hidden="true">404</p>
    <div>
      <p class="kicker kicker-accent">Page Not Found</p>
      <h1>This path doesn't lead anywhere yet.</h1>
    </div>
    <p class="hero-copy">
      The page you're looking for may have moved or no longer exists. Let's get you back on the
      journey.
    </p>
    <div class="hero-actions">
      <Button href="/" type="button">Return Home</Button>
      <Button href="/contact/" type="button" variant="outline">Contact Us</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(4.5rem, 14vw, 8rem);
    line-height: 1;
    margin: 0;
    color: var(--tone-primary);
  }
</style>
