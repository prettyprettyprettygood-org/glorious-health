---
import { ArrowDown, Heart, Sprout, Users } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { SITE } from '../config/site';
---

<BaseLayout title={`${SITE.name} — ${SITE.tagline}`} description={SITE.description}>
  <section class="section hero stack">
    <h1 class="visually-hidden">{SITE.name} — {SITE.tagline}</h1>
    <div class="hero-logo-frame">
      <img
        src="/images/logo.png"
        alt=""
        class="hero-logo"
        width="1050"
        height="600"
        fetchpriority="high"
      />
    </div>

    <p class="hero-copy">
      A healing journey for widows built on gatherings, connection, and sisterhood — walking
      alongside women rebuilding faith, community, and hope after loss.
    </p>
    <div class="hero-actions">
      <Button href="/gatherings/" type="button">Join a Gathering</Button>
      <Button href="/about/" type="button" variant="outline">Meet Our Founder</Button>
    </div>
    <a href="#pillars" class="hero-scroll-cue" aria-label="Scroll to see more">
      <ArrowDown aria-hidden="true" />
    </a>
  </section>

  <section class="section">
    <div class="grid feature-panel">
      <img
        src="/images/woman-bible.jpg"
        alt="A woman reading Scripture in a quiet moment"
        class="feature-panel-photo"
        width="1920"
        height="1280"
        loading="lazy"
        decoding="async"
      />
      <div class="feature-panel-content">
        <p class="kicker">Welcome</p>
        <h2>A community rooted in faith.</h2>
        <p>
          Grief touches every part of life — body, mind, and spirit. Glorious Health Ministries
          walks alongside widows with Scripture, community, and practical tools for healing, so no
          one has to carry this journey alone.
        </p>
      </div>
    </div>
  </section>

  <section id="pillars" class="section stack">
    <div>
      <p class="kicker">What We Offer</p>
      <h2>Gatherings, connection, and sisterhood.</h2>
    </div>
    <div class="grid grid-3 card-grid">
      <Card
        title="Gatherings"
        eyebrow="In-Person & Online"
        href="/gatherings/"
        class="card-heading-center"
      >
        <Fragment slot="icon">
          <span class="pillar-icon pillar-icon--primary" aria-hidden="true">
            <Sprout />
          </span>
        </Fragment>
        Workshops that blend faith, herbal wisdom, and grief education to help widows heal in body, mind,
        and spirit.
      </Card>
      <Card title="Connection" eyebrow="Resources" href="/connection/" class="card-heading-center">
        <Fragment slot="icon">
          <span class="pillar-icon pillar-icon--secondary" aria-hidden="true">
            <Users />
          </span>
        </Fragment>
        Recommended websites and books to support your healing journey between gatherings.
      </Card>
      <Card
        title="Sisterhood"
        eyebrow="Reflections & Writing"
        href="/sisterhood/"
        class="card-heading-center"
      >
        <Fragment slot="icon">
          <span class="pillar-icon pillar-icon--primary" aria-hidden="true">
            <Heart />
          </span>
        </Fragment>
        Ajai's blog and writing — encouragement from a woman walking this journey herself.
      </Card>
    </div>
  </section>

  <section class="section">
    <div class="grid feature-panel feature-panel--reverse feature-panel--light">
      <img
        src="/images/stone-love-table.jpg"
        alt="A hand-painted stone reading 'For all those we have loved and lost'"
        class="feature-panel-photo"
        width="1920"
        height="1280"
        loading="lazy"
        decoding="async"
      />
      <div class="feature-panel-content">
        <p class="kicker kicker-accent">In Memory</p>
        <h2>For all those we have loved and lost.</h2>
        <p>
          Every gathering begins the same way — by making space to honor who came before. This
          ministry exists because grief deserves to be witnessed, not rushed.
        </p>
      </div>
    </div>
  </section>

  <section class="section stack">
    <div class="grid grid-2 card-grid">
      <Card title="Meet Our Founder" eyebrow="About" href="/about/">
        Ajai Blue-Saunders, Certified Peer Grief Educator — her story, background, and how she
        ministers to widows.
      </Card>
      <Card title="Reach Out" eyebrow="Contact" href="/contact/">
        Questions about a gathering, a speaking invitation, or grief support? Send Ajai a message.
      </Card>
    </div>
  </section>
</BaseLayout>
