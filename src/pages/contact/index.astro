---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfoBlock from '../../components/ui/InfoBlock.astro';
import StyledDropdown from '../../components/ui/StyledDropdown.astro';
import { SITE } from '../../config/site';

const reasons = [
  'General Question',
  'Workshop Inquiry',
  'Grief Support',
  'Speaking Invitation',
  'Other',
];
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description="Reach out to Ajai Blue-Saunders about a gathering, grief support, or a speaking invitation."
>
  <section class="section stack stack-loose">
    <div class="section-heading-row section-heading-row--center">
      <div>
        <p class="kicker">Get In Touch</p>
        <h1>Reach out and Connect</h1>
      </div>
      <div class="motif-divider">
        <img
          src="/images/dove-hands.png"
          alt=""
          class="motif-divider-icon"
          width="289"
          height="342"
        />
      </div>
    </div>

    <div class="grid grid-2 contact-grid">
      <div class="stack">
        <div class="form-card-heading">
          <p class="info-block-eyebrow">Send a Message</p>
          <h2>I'd love to hear from you.</h2>
        </div>
        <form class="form" action="https://formspree.io/f/mgoggaer" method="POST" data-contact-form>
          <div class="form-field">
            <label class="form-label" for="contact-name">Name</label>
            <input class="form-input" type="text" id="contact-name" name="name" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="contact-email">Email</label>
            <input class="form-input" type="email" id="contact-email" name="email" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="contact-phone">Phone (optional)</label>
            <input class="form-input" type="tel" id="contact-phone" name="phone" />
          </div>
          <StyledDropdown
            id="contact-reason"
            name="reason"
            label="Reason for reaching out"
            options={reasons}
          />
          <div class="form-field">
            <label class="form-label" for="contact-message">Message</label>
            <textarea class="form-textarea" id="contact-message" name="message" required></textarea>
          </div>
          <p class="form-error" data-contact-form-error role="alert" hidden>
            Something went wrong sending your message. Please try again, or email us directly.
          </p>
          <div class="hero-actions hero-actions--end">
            <button type="submit" class="btn btn-solid btn-md" data-contact-form-submit>
              Send Message
            </button>
          </div>
        </form>
        <div class="form-success" data-contact-form-success role="status" hidden>
          <p class="form-success-title">Thank you for reaching out.</p>
          <p>I have received your message and will be in touch soon.</p>
        </div>
      </div>

      <div class="stack">
        <img
          src="/images/holding-hands.jpg"
          alt="Two women holding hands in a grassy field"
          class="photo-frame"
          width="1920"
          height="1282"
          loading="lazy"
          decoding="async"
        />
        <InfoBlock title="Contact Details" eyebrow="Reach Us">
          <p>
            <strong>Email:</strong>{' '}
            <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
          </p>
          <p><strong>Address:</strong> {SITE.contactAddress}</p>
        </InfoBlock>
        <InfoBlock
          title="Referral Partners"
          eyebrow="Churches & Funeral Homes"
          class="info-block--secondary"
        >
          I welcome partnering with churches, funeral homes, and nonprofits to help widows find
          their way to a gathering or support. A printable flyer is coming soon to distribute —
          watch for it!
        </InfoBlock>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!(form instanceof HTMLFormElement) || form.dataset.contactFormEnhanced === 'true') {
      return;
    }
    form.dataset.contactFormEnhanced = 'true';

    const submitButton = form.querySelector('[data-contact-form-submit]');
    const errorMessage = form.querySelector('[data-contact-form-error]');
    const successMessage = document.querySelector('[data-contact-form-success]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (errorMessage instanceof HTMLElement) {
        errorMessage.hidden = true;
      }
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch(form.action, {
          method: form.method,
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (!response.ok) {
          throw new Error('Form submission failed');
        }

        if (successMessage instanceof HTMLElement) {
          form.hidden = true;
          successMessage.hidden = false;
        }
      } catch {
        if (errorMessage instanceof HTMLElement) {
          errorMessage.hidden = false;
        }
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  })();
</script>
